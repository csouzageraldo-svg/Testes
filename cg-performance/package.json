{
  "name": "cg-performance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CG Performance — PWA de treinador inteligente orientado à metodologia CrossFit (não oficial, não afiliado).",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts --prod",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "dexie": "4.0.10",
    "dexie-react-hooks": "1.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3",
    "tesseract.js": "5.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "fake-indexeddb": "6.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
